generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

/// How often a user wants due items emailed to them. ASAP means the next
/// scheduler pass, not instantly — delivery is bounded by NOTIFY_INTERVAL_MINUTES.
enum EmailDigest {
  OFF
  ASAP
  DAILY
  WEEKLY
}

enum PropertyType {
  HOUSE
  CONDO
  TOWNHOUSE
  LOT
  OTHER
}

enum AssetType {
  PROPERTY
  VEHICLE
  EQUIPMENT
  PERSON
}

/// What a vehicle's odometer-style field on maintenance schedules and service
/// records actually counts — miles for cars, hours for engines with an hour
/// meter instead (mowers, generators, boats, tractors).
enum MeterUnit {
  MILES
  HOURS
}

/// What kind of spending a service record represents, as distinct from what it was
/// spent on. Nullable on the record: anything logged before categories existed is
/// genuinely uncategorized, and the reports say so rather than guessing.
/// The medical values are offered only on people's records — see lib/costs.ts.
enum ServiceCategory {
  ROUTINE
  REPAIR
  UPGRADE
  INSPECTION
  PARTS
  OTHER
  OFFICE_VISIT
  PRESCRIPTION
  LAB
  DENTAL
  VISION
  PROCEDURE
  THERAPY
}

enum EquipmentCategory {
  APPLIANCE
  HVAC
  WATER
  ELECTRONICS
  TOOL
  OUTDOOR
  SECURITY
  OTHER
}

enum Relationship {
  SELF
  SPOUSE
  CHILD
  PARENT
  PET
  OTHER
}

enum ConditionStatus {
  ACTIVE
  MANAGED
  RESOLVED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

enum InsuranceKind {
  MEDICAL
  DENTAL
  VISION
  OTHER
}

enum AttachmentRecordType {
  SERVICE
  WARRANTY
  MAINTENANCE
  CONDITION
  INSURANCE
  OBSERVATION
  MEDICATION
  ALLERGY
  IMMUNIZATION
  /// A file on the asset itself — a manual, title, deed — with no record around it.
  DOCUMENT
  /// Dropped into the capture inbox and not yet filed anywhere.
  INBOX
}

/// Where a capture-inbox item is: waiting for its text, read, or unreadable.
enum InboxStatus {
  PENDING
  READY
  FAILED
}

/// How the capture inbox reads a receipt: not at all, the built-in parser, or
/// the configured LLM (falling back to the built-in parser).
enum CaptureParser {
  OFF
  BASIC
  LLM
}

enum NotificationRepeat {
  ONCE
  REACHED_AND_DUE
  UNTIL_DISMISSED
}

enum NotificationType {
  MAINTENANCE_DUE
  WARRANTY_EXPIRING
  CUSTOM
  MEDICATION_REFILL
  IMMUNIZATION_DUE
  INSURANCE_EXPIRING
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  passwordHash      String
  role              Role     @default(USER)
  mustResetPassword Boolean  @default(false)
  /// Bumped to end every session this account has (password change, admin reset).
  sessionVersion    Int      @default(0)
  createdAt         DateTime @default(now())

  emailDigest   EmailDigest @default(DAILY)
  /// Chosen by an admin under Settings → Notifications. Off means no new
  /// in-app notifications and no digest emails for this account.
  receivesNotifications Boolean @default(true)
  /// How often a due item is raised again — see lib/notifications/repeat.ts.
  notificationRepeat NotificationRepeat @default(REACHED_AND_DUE)
  /// When this user was last emailed, so a cadence can be measured from it.
  lastDigestAt  DateTime?

  notifications  Notification[]
  serviceRecords ServiceRecord[]
  observations   Observation[]
  attachments    Attachment[]
  inboxItems     InboxItem[]
}

// ─── Assets ───────────────────────────────────────────────────────────────────

model Property {
  id            String       @id @default(cuid())
  name          String
  type          PropertyType @default(HOUSE)
  address       String
  purchaseDate  DateTime?
  purchasePrice Float?
  yearBuilt     Int?
  sqFt          Int?
  notes         String?
  imageFilename String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  equipment Equipment[]
}

model Vehicle {
  id             String    @id @default(cuid())
  name           String
  make           String
  model          String
  year           Int
  vin            String?
  color          String?
  purchaseDate   DateTime?
  purchasePrice  Float?
  currentMileage Int?
  meterUnit      MeterUnit @default(MILES)
  notes          String?
  imageFilename  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Equipment {
  id            String            @id @default(cuid())
  name          String
  category      EquipmentCategory @default(APPLIANCE)
  manufacturer  String?
  modelNumber   String?
  serialNumber  String?
  location      String?
  purchaseDate  DateTime?
  purchasePrice Float?
  installDate   DateTime?
  notes         String?
  imageFilename String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
}

// ─── People & health ──────────────────────────────────────────────────────────

model Person {
  id            String       @id @default(cuid())
  name          String
  relationship  Relationship @default(OTHER)
  dateOfBirth   DateTime?
  sex           String?
  bloodType     String?
  notes         String?
  imageFilename String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  primaryProviderId String?
  primaryProvider   Provider? @relation("PrimaryProvider", fields: [primaryProviderId], references: [id], onDelete: SetNull)

  conditions        HealthCondition[]
  medications       Medication[]
  allergies         Allergy[]
  immunizations     Immunization[]
  insurancePolicies InsurancePolicy[]
  observations      Observation[]
}

/// Shared household directory, not owned by one person.
model Provider {
  id        String   @id @default(cuid())
  name      String
  specialty String?
  practice  String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryFor     Person[]          @relation("PrimaryProvider")
  conditions     HealthCondition[]
  prescriptions  Medication[]
  serviceRecords ServiceRecord[]
}

model HealthCondition {
  id            String          @id @default(cuid())
  name          String
  status        ConditionStatus @default(ACTIVE)
  diagnosedDate DateTime?
  resolvedDate  DateTime?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  personId   String
  person     Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  medications    Medication[]
  serviceRecords ServiceRecord[]
  observations   Observation[]
  attachments    Attachment[]
}

/// Something noticed about a person on a day — a meltdown, a bad night, a
/// symptom — logged by any household member and reviewed for patterns later.
model Observation {
  id              String   @id @default(cuid())
  /// The day it happened (midnight UTC, like other health dates).
  date            DateTime
  /// Optional "HH:MM", 24-hour, local to the household.
  time            String?
  /// Free text, e.g. "Meltdown"; the form suggests types used before.
  type            String
  /// 1 (mild) to 5 (severe).
  severity        Int?
  durationMinutes Int?
  notes           String?
  /// Comma-separated, e.g. "school, tired".
  tags            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  personId    String
  person      Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  conditionId String?
  condition   HealthCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])

  attachments Attachment[]

  @@index([personId, date])
}

model Medication {
  id                 String    @id @default(cuid())
  name               String
  dosage             String?
  frequency          String?
  pharmacy           String?
  startDate          DateTime?
  endDate            DateTime?
  refillIntervalDays Int?
  nextRefillDate     DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  personId     String
  person       Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  prescriberId String?
  prescriber   Provider?        @relation(fields: [prescriberId], references: [id], onDelete: SetNull)
  conditionId  String?
  condition    HealthCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull)

  attachments  Attachment[]
}

model Allergy {
  id        String          @id @default(cuid())
  substance String
  reaction  String?
  severity  AllergySeverity @default(MODERATE)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  attachments Attachment[]
}

model Immunization {
  id          String    @id @default(cuid())
  vaccine     String
  dateGiven   DateTime
  dose        String?
  givenBy     String?
  nextDueDate DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  attachments Attachment[]
}

model InsurancePolicy {
  id             String        @id @default(cuid())
  carrier        String
  planName       String?
  kind           InsuranceKind @default(MEDICAL)
  policyNumber   String?
  groupNumber    String?
  memberId       String?
  phone          String?
  startDate      DateTime?
  endDate        DateTime?
  deductible     Float?
  outOfPocketMax Float?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  members     Person[]
  attachments Attachment[]
}

// ─── Service Records ──────────────────────────────────────────────────────────

model ServiceRecord {
  id               String    @id @default(cuid())
  assetId          String
  assetType        AssetType
  date             DateTime
  title            String
  description      String?
  vendor           String?
  cost             Float?
  category         ServiceCategory?
  mileageAtService Int?
  /// Person records only: who was seen and what for. vendor stays free text for
  /// facilities outside the provider directory.
  providerId       String?
  provider         Provider?        @relation(fields: [providerId], references: [id], onDelete: SetNull)
  conditionId      String?
  condition        HealthCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  attachments Attachment[]
}

// ─── Warranties ───────────────────────────────────────────────────────────────

model Warranty {
  id             String    @id @default(cuid())
  assetId        String
  assetType      AssetType
  productName    String
  purchaseDate   DateTime?
  expirationDate DateTime?
  vendor         String?
  vendorPhone    String?
  vendorEmail    String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attachments Attachment[]
}

// ─── Maintenance ──────────────────────────────────────────────────────────────

model MaintenanceSchedule {
  id                   String    @id @default(cuid())
  assetId              String
  assetType            AssetType
  title                String
  description          String?
  intervalDays         Int?
  intervalMiles        Int?
  lastCompletedDate    DateTime?
  lastCompletedMileage Int?
  nextDueDate          DateTime?
  nextDueMileage       Int?
  reminderDaysBefore   Int       @default(14)
  reminderMilesBefore  Int       @default(500)
  /// False while paused: kept on the asset page, left out of due counts and notifications.
  isActive             Boolean   @default(true)
  /// Hidden from the dashboard and notifications until then. The due date doesn't move.
  snoozedUntil         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  attachments Attachment[]
}

// ─── Attachments ──────────────────────────────────────────────────────────────

model Attachment {
  id           String               @id @default(cuid())
  recordType   AttachmentRecordType
  filename     String               // UUID-based name stored on disk
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedAt   DateTime             @default(now())

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  serviceRecordId       String?
  serviceRecord         ServiceRecord?       @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)

  warrantyId            String?
  warranty              Warranty?            @relation(fields: [warrantyId], references: [id], onDelete: Cascade)

  maintenanceScheduleId String?
  maintenanceSchedule   MaintenanceSchedule? @relation(fields: [maintenanceScheduleId], references: [id], onDelete: Cascade)

  healthConditionId     String?
  healthCondition       HealthCondition?     @relation(fields: [healthConditionId], references: [id], onDelete: Cascade)

  insurancePolicyId     String?
  insurancePolicy       InsurancePolicy?     @relation(fields: [insurancePolicyId], references: [id], onDelete: Cascade)

  observationId         String?
  observation           Observation?         @relation(fields: [observationId], references: [id], onDelete: Cascade)

  medicationId          String?
  medication            Medication?          @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  allergyId             String?
  allergy               Allergy?             @relation(fields: [allergyId], references: [id], onDelete: Cascade)

  immunizationId        String?
  immunization          Immunization?        @relation(fields: [immunizationId], references: [id], onDelete: Cascade)

  /// DOCUMENT only: the property, vehicle, equipment or person the file sits on.
  /// Polymorphic like ServiceRecord's, so no foreign key: deleting the asset
  /// deletes these rows itself (lib/asset-delete-server.ts, deletePerson).
  assetType             AssetType?
  assetId               String?

  inboxItemId           String?
  inboxItem             InboxItem?           @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)

  text                  AttachmentText?

  @@index([assetType, assetId])
  @@index([inboxItemId])
}

// ─── Capture inbox ────────────────────────────────────────────────────────────

/// A file dropped into the inbox before anyone chose its record. The parsed
/// fields are suggestions for the filing form, never applied on their own.
model InboxItem {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  status      InboxStatus @default(PENDING)
  parsedDate   DateTime?
  parsedTotal  Float?
  parsedVendor String?
  /// "basic" or "llm"; null when nothing was parsed (reading off, or no text).
  parseMethod  String?
  /// Why Local AI was chosen but the built-in parser read it: "llm-not-ready", "llm-health",
  /// "llm-failed" or "llm-no-answer". Null otherwise. A fixed code, never receipt text.
  parseNote    String?
  suggestedAssetType AssetType?
  suggestedAssetId   String?
  /// Why that asset was suggested, in words for the card ("VIN on the receipt"). Never the matched value.
  suggestedReason    String?
  /// The suggestion was set by the person adding the file (dropped on an asset's
  /// page), so the reader keeps it instead of matching.
  suggestedByUser    Boolean     @default(false)
  /// Fixed phrase shown on the item, e.g. the extractor's error.
  error       String?

  attachments Attachment[]
}

// ─── Mail settings ────────────────────────────────────────────────────────────

/// Single row (id is always "singleton"). Anything set here overrides the
/// matching SMTP_* environment variable, so an existing compose file keeps
/// working and the UI can override it without a container restart.
model MailSettings {
  id          String   @id @default("singleton")
  host        String?
  port        Int?
  username    String?
  /// AES-256-GCM, keyed from AUTH_SECRET — see lib/secret-box.ts. Never leaves
  /// the server; the UI is only told whether one is stored.
  passwordEnc String?
  /// null means "decide from the port", matching the env behaviour.
  secure      Boolean?
  fromAddress String?
  digestHour  Int?
  updatedAt   DateTime @updatedAt
}

// ─── LLM settings ─────────────────────────────────────────────────────────────

/// Single row (id is always "singleton"). Configured from Settings only — no
/// environment fallback. Any OpenAI-compatible Chat Completions server works.
model LlmSettings {
  id           String   @id @default("singleton")
  enabled      Boolean  @default(false)
  /// Hides the assistant from the nav and header while it's off. Only
  /// meaningful while enabled is false — turning the assistant on clears it.
  hidden       Boolean  @default(false)
  /// e.g. https://api.openai.com/v1 or http://localhost:11434/v1 — no trailing slash.
  baseUrl      String?
  /// AES-256-GCM via lib/secret-box.ts. Optional: local servers need none.
  /// Never leaves the server; the UI is only told whether one is stored.
  apiKeyEnc    String?
  model        String?
  /// null = provider default.
  temperature  Float?
  /// Cap on each completion; null = provider default.
  maxTokens    Int?
  /// Appended to the built-in system prompt.
  systemPrompt String?
  /// Per-question time limit in seconds; null = the built-in default.
  timeoutSeconds Int?
  /// Most rounds of lookups per question; null = the built-in default.
  maxToolRounds Int?
  /// JSON object merged into every request, e.g. {"chat_template_kwargs":{"enable_thinking":true}}.
  extraBody    String?
  /// Offer search_documents / read_document to the assistant.
  documentsEnabled       Boolean  @default(true)
  /// Include attachments on health records (conditions, observations,
  /// medications, allergies, immunizations) in those tools.
  healthDocumentsEnabled Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

// ─── Document text and search ─────────────────────────────────────────────────

enum DocumentTextStatus {
  PENDING      // queued, or needs redoing
  DONE         // text extracted
  EMPTY        // readable file, no text found
  UNSUPPORTED  // file type we don't extract
  FAILED       // extractor threw or timed out; see error
}

enum DocumentTextMethod {
  TEXT   // native text: PDF text layer, office, plain
  OCR    // every page came from OCR
  MIXED  // PDF with some text pages and some OCR'd pages
}

/// Extracted text of one attachment. Canonical: search-index.db is rebuilt
/// from these rows, never the other way round.
model AttachmentText {
  attachmentId     String              @id
  attachment       Attachment          @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  status           DocumentTextStatus  @default(PENDING)
  method           DocumentTextMethod?
  /// Pages separated by "\f". Capped at MAX_TEXT_CHARS.
  text             String?
  pageCount        Int?
  charCount        Int?
  truncated        Boolean             @default(false)
  /// Fixed phrase, never parser output, e.g. "Password-protected PDF".
  error            String?
  attempts         Int                 @default(0)
  /// EXTRACTOR_VERSION at extraction time. Bumping the constant re-queues everything.
  extractorVersion Int                 @default(0)
  extractedAt      DateTime?

  @@index([status])
}

/// Single row (id is always "singleton"). No row = defaults.
model DocumentSettings {
  id              String   @id @default("singleton")
  /// Master switch for extraction, OCR and the search index.
  indexingEnabled Boolean  @default(true)
  /// OCR images and scanned PDFs during indexing. CPU-heavy on small hosts.
  ocrEnabled      Boolean  @default(true)
  /// Embed chunks and use them in search_documents. Needs indexingEnabled.
  semanticEnabled Boolean  @default(true)
  /// Vetted model id (lib/documents/embed/models.ts). Default is the built-in one.
  embeddingModel  String   @default("bge-small-en-v1.5")
  /// How the capture inbox reads receipts. LLM falls back to BASIC when the assistant is off.
  captureParser   CaptureParser @default(BASIC)
  updatedAt       DateTime @updatedAt
}

/// Optional parts of the site an admin can switch off. Turning one off hides
/// it everywhere — nav, pages, search, notifications, the assistant — without
/// touching its data, so switching it back on brings everything back.
model FeatureSettings {
  id            String   @id @default("singleton")
  /// People, providers, insurance and everything owned by a person.
  healthEnabled Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id                String           @id @default(cuid())
  type              NotificationType
  title             String
  message           String
  isRead            Boolean          @default(false)
  relatedEntityId   String?
  relatedEntityType String?
  createdAt         DateTime         @default(now())
  /// Set once this notification has gone out in a digest email. Null means it
  /// is still pending delivery, so a failed send is simply retried next pass.
  emailedAt         DateTime?
  /// Set when the user dismisses it: hidden from the list and the bell until
  /// they choose to show hidden notifications.
  dismissedAt       DateTime?
  /// Which due date of the item this is about, so a new due date starts afresh.
  /// Null on rows from before cycles were tracked.
  cycleKey          String?
  /// REACHED (inside the warning window) or DUE (on or after the due date).
  stage             String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}
