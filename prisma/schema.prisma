generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

/// How often a user wants due items emailed to them. ASAP means the next
/// scheduler pass, not instantly — delivery is bounded by NOTIFY_INTERVAL_MINUTES.
enum EmailDigest {
  OFF
  ASAP
  DAILY
  WEEKLY
}

enum PropertyType {
  HOUSE
  CONDO
  TOWNHOUSE
  LOT
  OTHER
}

enum AssetType {
  PROPERTY
  VEHICLE
  EQUIPMENT
  PERSON
}

/// What a vehicle's odometer-style field on maintenance schedules and service
/// records actually counts — miles for cars, hours for engines with an hour
/// meter instead (mowers, generators, boats, tractors).
enum MeterUnit {
  MILES
  HOURS
}

/// What kind of spending a service record represents, as distinct from what it was
/// spent on. Nullable on the record: anything logged before categories existed is
/// genuinely uncategorized, and the reports say so rather than guessing.
/// The medical values are offered only on people's records — see lib/costs.ts.
enum ServiceCategory {
  ROUTINE
  REPAIR
  UPGRADE
  INSPECTION
  PARTS
  OTHER
  OFFICE_VISIT
  PRESCRIPTION
  LAB
  DENTAL
  VISION
  PROCEDURE
  THERAPY
}

enum EquipmentCategory {
  APPLIANCE
  HVAC
  WATER
  ELECTRONICS
  TOOL
  OUTDOOR
  SECURITY
  OTHER
}

enum EquipmentValueClass {
  /// Part of the home: insured with the dwelling.
  FIXTURE
  /// Belongings: insured as personal property.
  CONTENTS
}

enum Relationship {
  SELF
  SPOUSE
  CHILD
  PARENT
  PET
  OTHER
}

enum ConditionStatus {
  ACTIVE
  MANAGED
  RESOLVED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

enum InsuranceKind {
  MEDICAL
  DENTAL
  VISION
  /// Health-gated (every policy before step 5 was made under Health). PROPERTY_OTHER shows as Other.
  OTHER
  HOME
  RENTERS
  AUTO
  UMBRELLA
  LIFE
  PROPERTY_OTHER
}

enum AttachmentRecordType {
  SERVICE
  WARRANTY
  MAINTENANCE
  CONDITION
  INSURANCE
  OBSERVATION
  MEDICATION
  ALLERGY
  IMMUNIZATION
  /// A file on the asset itself — a manual, title, deed — with no record around it.
  DOCUMENT
  /// Dropped into the capture inbox and not yet filed anywhere.
  INBOX
  /// A file on a room: photos, paint receipts, floor plans.
  ROOM
}

/// Where a capture-inbox item is: waiting for its text, read, or unreadable.
enum InboxStatus {
  PENDING
  READY
  FAILED
}

/// How the capture inbox reads a receipt: not at all, the built-in parser, or
/// the configured LLM (falling back to the built-in parser).
enum CaptureParser {
  OFF
  BASIC
  LLM
}

enum NotificationRepeat {
  ONCE
  REACHED_AND_DUE
  UNTIL_DISMISSED
}

enum NotificationType {
  MAINTENANCE_DUE
  WARRANTY_EXPIRING
  CUSTOM
  MEDICATION_REFILL
  IMMUNIZATION_DUE
  INSURANCE_EXPIRING
  /// Non-health policy renewals; raised whether or not Health is on.
  POLICY_RENEWAL
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  passwordHash      String
  role              Role     @default(USER)
  mustResetPassword Boolean  @default(false)
  /// Bumped to end every session this account has (password change, admin reset).
  sessionVersion    Int      @default(0)
  createdAt         DateTime @default(now())

  emailDigest           EmailDigest        @default(DAILY)
  /// Chosen by an admin under Settings → Notifications. Off means no new
  /// in-app notifications and no digest emails for this account.
  receivesNotifications Boolean            @default(true)
  /// How often a due item is raised again — see lib/notifications/repeat.ts.
  notificationRepeat    NotificationRepeat @default(REACHED_AND_DUE)
  /// When this user was last emailed, so a cadence can be measured from it.
  lastDigestAt          DateTime?

  notifications  Notification[]
  serviceRecords ServiceRecord[]
  observations   Observation[]
  attachments    Attachment[]
  inboxItems     InboxItem[]
  passwordResets PasswordResetToken[]
}

/// A one-time "forgot password" link. Only the SHA-256 of the token is stored, so
/// a copy of the database can't be used to reset anyone's password. A user has at
/// most one live row: asking again replaces it.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Assets ───────────────────────────────────────────────────────────────────

model Property {
  id            String       @id @default(cuid())
  name          String
  type          PropertyType @default(HOUSE)
  address       String
  purchaseDate  DateTime?
  purchasePrice Float?
  yearBuilt     Int?
  sqFt          Int?
  notes         String?
  imageFilename String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  equipment Equipment[]
  rooms     Room[]
  vehicles  Vehicle[]
  people    Person[]

  insurancePolicies InsurancePolicy[]
}

/// A room inside a property: finishes, photos, and the equipment and records tagged to it.
model Room {
  id                String    @id @default(cuid())
  propertyId        String
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name              String
  /// Free text: "Main floor", "Upstairs".
  level             String?
  /// Labelled with RegionalSettings.areaUnit; never converted.
  area              Float?
  /// Free text: "14 × 16 ft".
  dimensions        String?
  /// Free text with suggestions (Hardwood, LVP, Tile…).
  flooringType      String?
  /// Brand, product, color.
  flooringProduct   String?
  flooringInstalled DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  paints         RoomPaint[]
  equipment      Equipment[]
  serviceRecords ServiceRecord[]
  schedules      MaintenanceSchedule[]
  attachments    Attachment[]

  @@index([propertyId])
}

/// One painted surface in a room. Saved by replacing the room's rows.
model RoomPaint {
  id        String  @id @default(cuid())
  roomId    String
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// "Walls", "Ceiling", "Trim", "Accent wall".
  surface   String
  brand     String?
  colorName String?
  colorCode String?
  finish    String?
  sortOrder Int     @default(0)

  @@index([roomId])
}

model Vehicle {
  id             String    @id @default(cuid())
  name           String
  make           String
  model          String
  year           Int
  vin            String?
  color          String?
  purchaseDate   DateTime?
  purchasePrice  Float?
  currentMileage Int?
  meterUnit      MeterUnit @default(MILES)
  notes          String?
  imageFilename  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /// The property it belongs to, for the property filter. Optional.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  insurancePolicies InsurancePolicy[]

  @@index([propertyId])
}

model Equipment {
  id                String               @id @default(cuid())
  name              String
  category          EquipmentCategory    @default(APPLIANCE)
  manufacturer      String?
  modelNumber       String?
  serialNumber      String?
  location          String?
  purchaseDate      DateTime?
  purchasePrice     Float?
  installDate       DateTime?
  /// Part of the home or belongings. Null means the category's default (lib/equipment-value.ts).
  valueClass        EquipmentValueClass?
  /// How many years it should last, counted from installDate, else purchaseDate.
  expectedLifeYears Int?
  /// What replacing it would cost today.
  replacementCost   Float?
  notes             String?
  imageFilename     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  /// Where it lives, when that is one of the property's rooms. Wins over the free-text location.
  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([roomId])
}

// ─── People & health ──────────────────────────────────────────────────────────

model Person {
  id            String       @id @default(cuid())
  name          String
  relationship  Relationship @default(OTHER)
  dateOfBirth   DateTime?
  sex           String?
  bloodType     String?
  notes         String?
  imageFilename String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  primaryProviderId String?
  primaryProvider   Provider? @relation("PrimaryProvider", fields: [primaryProviderId], references: [id], onDelete: SetNull)

  /// The property this person belongs to, for the property filter. Optional.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  conditions        HealthCondition[]
  medications       Medication[]
  allergies         Allergy[]
  immunizations     Immunization[]
  insurancePolicies InsurancePolicy[]
  observations      Observation[]

  @@index([propertyId])
}

/// Shared household directory, not owned by one person.
model Provider {
  id        String   @id @default(cuid())
  name      String
  specialty String?
  practice  String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryFor     Person[]          @relation("PrimaryProvider")
  conditions     HealthCondition[]
  prescriptions  Medication[]
  serviceRecords ServiceRecord[]
}

model HealthCondition {
  id            String          @id @default(cuid())
  name          String
  status        ConditionStatus @default(ACTIVE)
  diagnosedDate DateTime?
  resolvedDate  DateTime?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  personId   String
  person     Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  medications    Medication[]
  serviceRecords ServiceRecord[]
  observations   Observation[]
  attachments    Attachment[]
}

/// Something noticed about a person on a day — a meltdown, a bad night, a
/// symptom — logged by any household member and reviewed for patterns later.
model Observation {
  id              String   @id @default(cuid())
  /// The day it happened (midnight UTC, like other health dates).
  date            DateTime
  /// Optional "HH:MM", 24-hour, local to the household.
  time            String?
  /// Free text, e.g. "Meltdown"; the form suggests types used before.
  type            String
  /// 1 (mild) to 5 (severe).
  severity        Int?
  durationMinutes Int?
  notes           String?
  /// Comma-separated, e.g. "school, tired".
  tags            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  personId    String
  person      Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  conditionId String?
  condition   HealthCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  attachments Attachment[]

  @@index([personId, date])
}

model Medication {
  id                 String    @id @default(cuid())
  name               String
  dosage             String?
  frequency          String?
  pharmacy           String?
  startDate          DateTime?
  endDate            DateTime?
  refillIntervalDays Int?
  nextRefillDate     DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  personId     String
  person       Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  prescriberId String?
  prescriber   Provider?        @relation(fields: [prescriberId], references: [id], onDelete: SetNull)
  conditionId  String?
  condition    HealthCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull)

  attachments Attachment[]
}

model Allergy {
  id        String          @id @default(cuid())
  substance String
  reaction  String?
  severity  AllergySeverity @default(MODERATE)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  attachments Attachment[]
}

model Immunization {
  id          String    @id @default(cuid())
  vaccine     String
  dateGiven   DateTime
  dose        String?
  givenBy     String?
  nextDueDate DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  attachments Attachment[]
}

model InsurancePolicy {
  id             String        @id @default(cuid())
  carrier        String
  planName       String?
  kind           InsuranceKind @default(MEDICAL)
  policyNumber   String?
  groupNumber    String?
  memberId       String?
  phone          String?
  startDate      DateTime?
  endDate        DateTime?
  deductible     Float?
  outOfPocketMax Float?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  members     Person[]
  properties  Property[]
  vehicles    Vehicle[]
  premiums    InsurancePremium[]
  coverages   InsuranceCoverage[]
  attachments Attachment[]
}

model InsurancePremium {
  id            String          @id @default(cuid())
  policyId      String
  policy        InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  amount        Float
  period        PremiumPeriod   @default(ANNUAL)
  notes         String?
  createdAt     DateTime        @default(now())

  @@index([policyId])
}

enum PremiumPeriod {
  MONTHLY
  SEMIANNUAL
  ANNUAL
}

model InsuranceCoverage {
  id         String          @id @default(cuid())
  policyId   String
  policy     InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  label      String
  limit      Float?
  deductible Float?
  sortOrder  Int             @default(0)

  @@index([policyId])
}

// ─── Service Records ──────────────────────────────────────────────────────────

model ServiceRecord {
  id               String           @id @default(cuid())
  assetId          String
  assetType        AssetType
  date             DateTime
  title            String
  description      String?
  vendor           String?
  cost             Float?
  category         ServiceCategory?
  mileageAtService Int?
  /// Person records only: who was seen and what for. vendor stays free text for
  /// facilities outside the provider directory.
  providerId       String?
  provider         Provider?        @relation(fields: [providerId], references: [id], onDelete: SetNull)
  conditionId      String?
  condition        HealthCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  /// Null once the author's account is deleted; the record stays.
  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  /// The room the work was done in, if any.
  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  attachments Attachment[]

  @@index([roomId])
}

// ─── Warranties ───────────────────────────────────────────────────────────────

model Warranty {
  id             String    @id @default(cuid())
  assetId        String
  assetType      AssetType
  productName    String
  purchaseDate   DateTime?
  expirationDate DateTime?
  vendor         String?
  vendorPhone    String?
  vendorEmail    String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attachments Attachment[]
}

// ─── Maintenance ──────────────────────────────────────────────────────────────

model MaintenanceSchedule {
  id                    String      @id @default(cuid())
  assetId               String
  assetType             AssetType
  title                 String
  description           String?
  intervalDays          Int?
  intervalMiles         Int?
  lastCompletedDate     DateTime?
  lastCompletedMileage  Int?
  nextDueDate           DateTime?
  nextDueMileage        Int?
  reminderDaysBefore    Int         @default(14)
  reminderMilesBefore   Int         @default(500)
  /// False while paused: kept on the asset page, left out of due counts and notifications.
  isActive              Boolean     @default(true)
  /// Hidden from the dashboard and notifications until then. The due date doesn't move.
  snoozedUntil          DateTime?
  /// What one occurrence is expected to cost.
  estimatedCost         Float?
  /// Calendar schedule: months 1–12, comma-separated and sorted. Can't be combined with an interval.
  dueMonths             String?
  /// Day of month (1–28) for a calendar schedule.
  dueDay                Int?
  /// A manual (or any file) to open when doing this: a DOCUMENT on the same asset or a file on this reminder. Cleared when the file is deleted.
  referenceAttachmentId String?
  referenceAttachment   Attachment? @relation("ScheduleManual", fields: [referenceAttachmentId], references: [id], onDelete: SetNull)
  /// Page of that file, from 1. Ignored without a file.
  referencePage         Int?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  /// The room the task is for, if any. Copied to the service record on completion.
  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  attachments Attachment[] @relation("ScheduleAttachments")

  @@index([roomId])
  @@index([referenceAttachmentId])
}

// ─── Attachments ──────────────────────────────────────────────────────────────

model Attachment {
  id           String               @id @default(cuid())
  recordType   AttachmentRecordType
  filename     String // UUID-based name stored on disk
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedAt   DateTime             @default(now())

  uploadedById String?
  uploadedBy   User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  serviceRecordId String?
  serviceRecord   ServiceRecord? @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)

  warrantyId String?
  warranty   Warranty? @relation(fields: [warrantyId], references: [id], onDelete: Cascade)

  maintenanceScheduleId String?
  maintenanceSchedule   MaintenanceSchedule? @relation("ScheduleAttachments", fields: [maintenanceScheduleId], references: [id], onDelete: Cascade)

  healthConditionId String?
  healthCondition   HealthCondition? @relation(fields: [healthConditionId], references: [id], onDelete: Cascade)

  insurancePolicyId String?
  insurancePolicy   InsurancePolicy? @relation(fields: [insurancePolicyId], references: [id], onDelete: Cascade)

  observationId String?
  observation   Observation? @relation(fields: [observationId], references: [id], onDelete: Cascade)

  medicationId String?
  medication   Medication? @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  allergyId String?
  allergy   Allergy? @relation(fields: [allergyId], references: [id], onDelete: Cascade)

  immunizationId String?
  immunization   Immunization? @relation(fields: [immunizationId], references: [id], onDelete: Cascade)

  /// DOCUMENT only: the property, vehicle, equipment or person the file sits on.
  /// Polymorphic like ServiceRecord's, so no foreign key: deleting the asset
  /// deletes these rows itself (lib/asset-delete-server.ts, deletePerson).
  assetType AssetType?
  assetId   String?

  inboxItemId String?
  inboxItem   InboxItem? @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  text AttachmentText?

  referencedBySchedules MaintenanceSchedule[] @relation("ScheduleManual")

  @@index([roomId])
  @@index([assetType, assetId])
  @@index([inboxItemId])
}

// ─── Capture inbox ────────────────────────────────────────────────────────────

/// A file dropped into the inbox before anyone chose its record. The parsed
/// fields are suggestions for the filing form, never applied on their own.
model InboxItem {
  id                 String      @id @default(cuid())
  createdAt          DateTime    @default(now())
  createdById        String?
  createdBy          User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  status             InboxStatus @default(PENDING)
  parsedDate         DateTime?
  parsedTotal        Float?
  parsedVendor       String?
  /// "basic" or "llm"; null when nothing was parsed (reading off, or no text).
  parseMethod        String?
  /// Why Local AI was chosen but the built-in parser read it: "llm-not-ready", "llm-health",
  /// "llm-failed" or "llm-no-answer". Null otherwise. A fixed code, never receipt text.
  parseNote          String?
  suggestedAssetType AssetType?
  suggestedAssetId   String?
  /// Why that asset was suggested, in words for the card ("VIN on the receipt"). Never the matched value.
  suggestedReason    String?
  /// The suggestion was set by the person adding the file (dropped on an asset's
  /// page), so the reader keeps it instead of matching.
  suggestedByUser    Boolean     @default(false)
  /// Fixed phrase shown on the item, e.g. the extractor's error.
  error              String?

  attachments Attachment[]
}

// ─── Mail settings ────────────────────────────────────────────────────────────

/// Single row (id is always "singleton"). Anything set here overrides the
/// matching SMTP_* environment variable, so an existing compose file keeps
/// working and the UI can override it without a container restart.
model MailSettings {
  id          String   @id @default("singleton")
  host        String?
  port        Int?
  username    String?
  /// AES-256-GCM, keyed from AUTH_SECRET — see lib/secret-box.ts. Never leaves
  /// the server; the UI is only told whether one is stored.
  passwordEnc String?
  /// null means "decide from the port", matching the env behaviour.
  secure      Boolean?
  fromAddress String?
  digestHour  Int?
  /// Where links in emails point (password reset, digest). null falls back to AUTH_URL.
  publicUrl   String?
  updatedAt   DateTime @updatedAt
}

// ─── LLM settings ─────────────────────────────────────────────────────────────

/// Single row (id is always "singleton"). Configured from Settings only — no
/// environment fallback. Any OpenAI-compatible Chat Completions server works.
model LlmSettings {
  id                     String   @id @default("singleton")
  enabled                Boolean  @default(false)
  /// Hides the assistant from the nav and header while it's off. Only
  /// meaningful while enabled is false — turning the assistant on clears it.
  hidden                 Boolean  @default(false)
  /// e.g. https://api.openai.com/v1 or http://localhost:11434/v1 — no trailing slash.
  baseUrl                String?
  /// AES-256-GCM via lib/secret-box.ts. Optional: local servers need none.
  /// Never leaves the server; the UI is only told whether one is stored.
  apiKeyEnc              String?
  model                  String?
  /// null = provider default.
  temperature            Float?
  /// Cap on each completion; null = provider default.
  maxTokens              Int?
  /// Appended to the built-in system prompt.
  systemPrompt           String?
  /// Per-question time limit in seconds; null = the built-in default.
  timeoutSeconds         Int?
  /// Most rounds of lookups per question; null = the built-in default.
  maxToolRounds          Int?
  /// JSON object merged into every request, e.g. {"chat_template_kwargs":{"enable_thinking":true}}.
  extraBody              String?
  /// Offer search_documents / read_document to the assistant.
  documentsEnabled       Boolean  @default(true)
  /// Include attachments on health records (conditions, observations,
  /// medications, allergies, immunizations) in those tools.
  healthDocumentsEnabled Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

// ─── Document text and search ─────────────────────────────────────────────────

enum DocumentTextStatus {
  PENDING // queued, or needs redoing
  DONE // text extracted
  EMPTY // readable file, no text found
  UNSUPPORTED // file type we don't extract
  FAILED // extractor threw or timed out; see error
}

enum DocumentTextMethod {
  TEXT // native text: PDF text layer, office, plain
  OCR // every page came from OCR
  MIXED // PDF with some text pages and some OCR'd pages
}

/// Extracted text of one attachment. Canonical: search-index.db is rebuilt
/// from these rows, never the other way round.
model AttachmentText {
  attachmentId     String              @id
  attachment       Attachment          @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  status           DocumentTextStatus  @default(PENDING)
  method           DocumentTextMethod?
  /// Pages separated by "\f". Capped at MAX_TEXT_CHARS.
  text             String?
  pageCount        Int?
  charCount        Int?
  truncated        Boolean             @default(false)
  /// Fixed phrase, never parser output, e.g. "Password-protected PDF".
  error            String?
  attempts         Int                 @default(0)
  /// EXTRACTOR_VERSION at extraction time. Bumping the constant re-queues everything.
  extractorVersion Int                 @default(0)
  extractedAt      DateTime?

  @@index([status])
}

/// Single row (id is always "singleton"). No row = defaults.
model DocumentSettings {
  id              String        @id @default("singleton")
  /// Master switch for extraction, OCR and the search index.
  indexingEnabled Boolean       @default(true)
  /// OCR images and scanned PDFs during indexing. CPU-heavy on small hosts.
  ocrEnabled      Boolean       @default(true)
  /// Embed chunks and use them in search_documents. Needs indexingEnabled.
  semanticEnabled Boolean       @default(true)
  /// Vetted model id (lib/documents/embed/models.ts). Default is the built-in one.
  embeddingModel  String        @default("bge-small-en-v1.5")
  /// How the capture inbox reads receipts. LLM falls back to BASIC when the assistant is off.
  captureParser   CaptureParser @default(BASIC)
  updatedAt       DateTime      @updatedAt
}

/// Optional parts of the site an admin can switch off. Turning one off hides
/// it everywhere — nav, pages, search, notifications, the assistant — without
/// touching its data, so switching it back on brings everything back.
model FeatureSettings {
  id                    String   @id @default("singleton")
  /// People, providers, health insurance and everything owned by a person.
  healthEnabled         Boolean  @default(true)
  /// Rooms inside properties: paint, flooring, photos, and what is tagged to them.
  roomsEnabled          Boolean  @default(true)
  /// The Equipment tab on a property and on its rooms.
  equipmentTabEnabled   Boolean  @default(true)
  /// A property dropdown in the top bar that leaves out everything belonging to other properties. Off by default.
  propertyFilterEnabled Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

/// How money, distances, areas and dates are written for this household.
/// Label only: switching a unit relabels stored numbers, it never converts them.
model RegionalSettings {
  id           String       @id @default("singleton")
  /// ISO 4217 code.
  currency     String       @default("USD")
  distanceUnit DistanceUnit @default(MILES)
  areaUnit     AreaUnit     @default(SQFT)
  dateFormat   DateFormat   @default(MDY_SHORT)
  hour12       Boolean      @default(true)
  updatedAt    DateTime     @updatedAt
}

enum DistanceUnit {
  MILES
  KM
}

enum AreaUnit {
  SQFT
  SQM
}

/// MDY_SHORT "Jan 5, 2026", DMY_SHORT "5 Jan 2026", MDY_NUM "01/05/2026", DMY_NUM "05/01/2026", ISO "2026-01-05".
enum DateFormat {
  MDY_SHORT
  DMY_SHORT
  MDY_NUM
  DMY_NUM
  ISO
}

// ─── Backup ──────────────────────────────────────────────────────────────────

enum BackupSchedule {
  OFF
  DAILY
  WEEKLY
}

enum BackupProtection {
  NONE
  KEY
  PASSWORD
}

enum BackupRunKind {
  BACKUP
  EXPORT
  RESTORE
}

enum BackupRunTrigger {
  MANUAL
  SCHEDULE
  CLI
}

enum BackupRunStatus {
  RUNNING
  OK
  WARN
  FAILED
  INTERRUPTED
}

/// Single row (id is always "singleton"). No row = defaults (schedule off, no protection).
model BackupSettings {
  id              String           @id @default("singleton")
  schedule        BackupSchedule   @default(OFF)
  /// "HH:mm", server local time (TZ).
  time            String           @default("03:00")
  /// 0 = Sunday … 6 = Saturday; WEEKLY only.
  weekday         Int              @default(0)
  /// null = <data dir>/backups.
  folder          String?
  keep            Int              @default(14)
  protection      BackupProtection @default(NONE)
  /// age X25519 recipient (age1…). The private key never reaches the server.
  publicKey       String?
  keyFingerprint  String?
  /// Password-zip passphrase, AES-256-GCM via lib/secret-box.ts.
  passphraseEnc   String?
  /// When the schedule was last turned on; staleness counts from here until the first backup.
  enabledAt       DateTime?
  hintDismissedAt DateTime?
  updatedAt       DateTime         @updatedAt
}

/// One backup, export or restore job: progress while running, history after.
model BackupRun {
  id            String           @id @default(cuid())
  kind          BackupRunKind
  trigger       BackupRunTrigger
  status        BackupRunStatus  @default(RUNNING)
  startedAt     DateTime         @default(now())
  finishedAt    DateTime?
  file          String?
  size          Int?
  protection    BackupProtection @default(NONE)
  progressDone  Int              @default(0)
  progressTotal Int              @default(0)
  /// JSON array of strings.
  warnings      String           @default("[]")
  error         String?
  createdById   String?

  @@index([kind, startedAt])
}

// ─── Notifications ────────────────────────────────────────────────────────────

/// Server-wide notification setup: how often the check runs and the one push
/// endpoint. A singleton, like MailSettings.
model NotificationSettings {
  id              String    @id @default("singleton")
  /// Minutes between checks; 0 turns them off. null falls back to
  /// NOTIFY_INTERVAL_MINUTES, then 360.
  intervalMinutes Int?
  pushEnabled     Boolean   @default(false)
  /// DISCORD, NTFY, TELEGRAM or JSON — see lib/notifications/push-format.ts.
  pushType        String?
  /// Webhook URL (it carries the secret for Discord), AES-256-GCM via
  /// lib/secret-box.ts. Never leaves the server.
  pushUrlEnc      String?
  /// Telegram bot token, or an optional bearer token for ntfy and JSON. Encrypted.
  pushTokenEnc    String?
  /// Telegram chat ID. Not a secret.
  pushChatId      String?
  /// The last failed send, shown on the settings page; cleared on success.
  pushLastError   String?
  pushLastOkAt    DateTime?
  updatedAt       DateTime  @updatedAt
}

model Notification {
  id                String           @id @default(cuid())
  type              NotificationType
  title             String
  message           String
  isRead            Boolean          @default(false)
  relatedEntityId   String?
  relatedEntityType String?
  createdAt         DateTime         @default(now())
  /// Set once this notification has gone out in a digest email. Null means it
  /// is still pending delivery, so a failed send is simply retried next pass.
  emailedAt         DateTime?
  /// Set once this notification has gone to the push endpoint (or was already
  /// there when push was turned on). Null means pending, so a failed send is retried.
  pushedAt          DateTime?
  /// Set when the user dismisses it: hidden from the list and the bell until
  /// they choose to show hidden notifications.
  dismissedAt       DateTime?
  /// Which due date of the item this is about, so a new due date starts afresh.
  /// Null on rows from before cycles were tracked.
  cycleKey          String?
  /// REACHED (inside the warning window) or DUE (on or after the due date).
  stage             String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}
